APP_NAME="Saba POS"
APP_ENV=production
APP_KEY=base64:FKGli4BSWnwArFDuG4J5YqHBbcQmy4iGrfPqd85Kd7g=
APP_DEBUG=false
APP_URL=https://pos.sababilling.net

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# MySQL Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sababill_pos
DB_USERNAME=sababill_pos
DB_PASSWORD=sababill_pos

# Session, Cache & Queue Drivers (File-based to prevent database lockouts)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="support@sababilling.net"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
