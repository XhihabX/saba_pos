APP_NAME="Saba POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pos.sababilling.net

# Logging Configuration
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# Database Credentials (MySQL)
# Note: On cPanel, your database name and username are prefixed with your cPanel account username.
# Example: If cPanel username is 'sababilling', use 'sababilling_sabapos' and 'sababilling_posusr'.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=YOUR_CPANEL_USER_sabapos
DB_USERNAME=YOUR_CPANEL_USER_posusr
DB_PASSWORD="YOUR_DATABASE_PASSWORD"

# Drivers (Must be 'database' on cPanel Shared Hosting)
BROADCAST_CONNECTION=null
CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Reverse Proxy & Trusted Proxies (Anti-Spoofing)
# Leave empty for standard cPanel without reverse proxy.
# If behind Cloudflare, supply Cloudflare IP CIDRs separated by commas.
TRUSTED_PROXIES=

# Mail Configuration (Optional - for supervisor PIN lockout alerts and subscription receipts)
MAIL_MAILER=smtp
MAIL_HOST=mail.sababilling.net
MAIL_PORT=465
MAIL_USERNAME=noreply@sababilling.net
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@sababilling.net"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
